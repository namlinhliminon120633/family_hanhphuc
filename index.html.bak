<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>20/10 - Món Quà Yêu Thương Gia Đình</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Alex+Brush&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <!-- Intro Overlay with Family Member Selection -->
  <div id="introOverlay" class="intro-overlay">
    <div class="intro-card">
      <div class="intro-heart">💖</div>
      <h2>Món Quà 20/10</h2>
      <p class="intro-sub">Gửi tới những người phụ nữ tuyệt vời nhất trong gia đình</p>
      
      <!-- Selection of recipient -->
      <div class="recipient-selector-group">
        <label class="selector-title">Món quà này dành tặng cho:</label>
        <div class="recipient-options">
          <button class="recipient-chip active" data-recipient="me">
            <span class="chip-icon">🌹</span>
            <span class="chip-name">Mẹ❤️</span>
          </button>
          <button class="recipient-chip" data-recipient="thuthuy">
            <span class="chip-icon">🌸</span>
            <span class="chip-name">Chị Thủy</span>
          </button>
          <button class="recipient-chip" data-recipient="thuhuong">
            <span class="chip-icon">💐</span>
            <span class="chip-name">Chị Hương</span>
          </button>
        </div>
      </div>

      <button id="startBtn" class="glow-btn">
        <span>✨ Chạm để khám phá ✨</span>
      </button>
      <p class="intro-hint">Bật âm thanh để có trải nghiệm trọn vẹn nhất</p>
    </div>
  </div>

  <!-- Audio Element -->
  <audio id="bgMusic" src="audio.mp3" loop preload="auto"></audio>

  <!-- Background Animated Scene -->
  <div class="scene">
    <!-- Starry & ambient glow layers -->
    <div class="ambient-glow glow-1"></div>
    <div class="ambient-glow glow-2"></div>
    <div class="ambient-glow glow-3"></div>

    <!-- Canvas for Floating Particles & Rose Petals -->
    <canvas id="petalCanvas"></canvas>

    <!-- Top Recipient Quick Switcher Bar -->
    <div class="top-switcher">
      <div class="switcher-label">Đang xem:</div>
      <button class="switch-pill active" data-target="me">🌹 Mẹ</button>
      <button class="switch-pill" data-target="thuthuy">🌸 Chị Thủy</button>
      <button class="switch-pill" data-target="thuhuong">💐 Chị Hương</button>
    </div>

    <!-- Glowing Heart & Date Behind the Mist -->
    <div class="behind-mist-content">
      <div class="date-badge">20 • 10</div>
      
      <!-- Pulsing Glowing Heart -->
      <div class="heart-wrapper">
        <div class="heart-pulse bk hr"></div>
        <div class="heart-glow"></div>
        <div class="heart-svg-container">
          <svg viewBox="0 0 100 90" class="heart-svg">
            <defs>
              <linearGradient id="heartGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#ff758c" />
                <stop offset="50%" stop-color="#ff4b72" />
                <stop offset="100%" stop-color="#f80759" />
              </linearGradient>
              <filter id="glowFilter" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feComposite in="SourceGraphic" in2="blur" operator="over" />
              </filter>
            </defs>
            <path d="M 50,25 
                     C 50,10 35,0 20,0 
                     C 5,0 0,15 0,25 
                     C 0,45 25,65 50,85 
                     C 75,65 100,45 100,25 
                     C 100,15 95,0 80,0 
                     C 65,0 50,10 50,25 Z" 
                  fill="url(#heartGrad)" 
                  filter="url(#glowFilter)" />
          </svg>
        </div>
      </div>

      <div id="greetingSubtitle" class="greeting-subtitle">Happy Vietnamese Women's Day</div>
      <div id="sparkleTag" class="sparkle-tag">Chúc Mẹ luôn dồi dào sức khỏe và bình an ✨</div>
    </div>

    <!-- Interactive Mist / Frosted Glass Canvas Layer -->
    <canvas id="mistCanvas"></canvas>

    <!-- Water Droplets Overlay for realistic glass effect -->
    <div id="dropletsContainer" class="droplets-container"></div>

    <!-- Hint / Guide to Wipe -->
    <div id="wipeHint" class="wipe-hint">
      <span class="hand-icon">👆</span>
      <span>Dùng tay hoặc chuột lau nhẹ lớp sương mờ...</span>
    </div>

    <!-- Bottom Poetic Lyrics tailored for family member -->
    <div class="title bottom-poem">
      <p id="poemLine1" class="poem-line line-1">Đằng sau sương mờ là tất cả</p>
      <p id="poemLine2" class="poem-line line-2">dịu dàng và sự biết ơn con muốn</p>
      <p id="poemLine3" class="poem-line line-3">gửi trao cho Mẹ ❤️</p>
    </div>

    <!-- Floating Action Controls -->
    <div class="controls-bar">
      <button id="musicToggle" class="ctrl-btn" title="Bật/Tắt nhạc">
        <span class="icon">🎵</span>
      </button>
      <button id="autoWipeBtn" class="ctrl-btn" title="Tự động lau sương">
        <span class="icon">🪄</span>
        <span class="label">Tự động lau</span>
      </button>
      <button id="refogBtn" class="ctrl-btn" title="Tạo lại sương mờ">
        <span class="icon">🌫️</span>
        <span class="label">Phủ sương</span>
      </button>
      <button id="letterBtn" class="ctrl-btn highlight" title="Mở thư chúc">
        <span class="icon">💌</span>
        <span class="label">Lời chúc</span>
      </button>
    </div>
  </div>

  <!-- Letter / Wishes Popup Modal -->
  <div id="letterModal" class="modal-overlay">
    <div class="modal-envelope">
      <button id="closeModalBtn" class="close-modal">&times;</button>
      <div id="letterStamp" class="letter-stamp">20/10 • Gửi Mẹ</div>
      <div class="letter-content">
        <h3 id="letterTitle" class="letter-title">Gửi Mẹ Yêu Dấu 🌹</h3>
        <p id="letterGreeting" class="letter-greeting">Nhân ngày Phụ nữ Việt Nam 20/10,</p>
        <div id="letterBodyContainer">
          <!-- Dynamically inserted letter paragraphs -->
        </div>
        <p id="letterSign" class="letter-sign">Con của Mẹ ❤️</p>
      </div>
    </div>
  </div>

  <!-- Toast Notification -->
  <div id="toast" class="toast-msg"></div>

  <script src="script.js"></script>
</body>
</html>
